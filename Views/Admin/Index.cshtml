@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AdminStyles.css" />
}

<div class="dashboard-page">

    <!-- Page Header -->
    <div class="dashboard-header">
        <div>
            <h1 class="dashboard-title">Admin Dashboard</h1>
            <p class="dashboard-subtitle">Overview of barangay waste management operations</p>
        </div>
        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            <span>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card stat-card-green">
            <div class="stat-icon"><i class="bi bi-geo-alt"></i></div>
            <div class="stat-info">
                <span class="stat-number">@(ViewBag.TotalSitios ?? 0)</span>
                <span class="stat-label">Total Sitios</span>
            </div>
        </div>
        <div class="stat-card stat-card-blue">
            <div class="stat-icon"><i class="bi bi-people"></i></div>
            <div class="stat-info">
                <span class="stat-number">@(ViewBag.TotalCollectors ?? 0)</span>
                <span class="stat-label">Garbage Collectors</span>
            </div>
        </div>
        <div class="stat-card stat-card-gold">
            <div class="stat-icon"><i class="bi bi-truck"></i></div>
            <div class="stat-info">
                <span class="stat-number">@(ViewBag.TotalTrucks ?? 0)</span>
                <span class="stat-label">Garbage Trucks</span>
            </div>
        </div>
        <div class="stat-card stat-card-purple">
            <div class="stat-icon"><i class="bi bi-calendar-check"></i></div>
            <div class="stat-info">
                <span class="stat-number">@(ViewBag.TotalSchedules ?? 0)</span>
                <span class="stat-label">Total Schedules</span>
            </div>
        </div>
    </div>

    <!-- Secondary Stats -->
    <div class="stats-grid-secondary">
        <div class="stat-card stat-card-red">
            <div class="stat-icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div class="stat-info">
                <span class="stat-number">@(ViewBag.TotalComplaints ?? 0)</span>
                <span class="stat-label">Total Complaints</span>
            </div>
        </div>
        <div class="stat-card stat-card-orange">
            <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
            <div class="stat-info">
                <span class="stat-number">@(ViewBag.PendingComplaints ?? 0)</span>
                <span class="stat-label">Pending Complaints</span>
            </div>
        </div>
        <div class="stat-card stat-card-teal">
            <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
            <div class="stat-info">
                <span class="stat-number">@(ViewBag.CompletedCollections ?? 0)</span>
                <span class="stat-label">Completed Collections</span>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
        <div class="quick-actions-header">
            <h3><i class="bi bi-lightning"></i> Quick Actions</h3>
        </div>
        <div class="actions-grid">
            <!-- New Schedule -->
            <a asp-controller="CollectionSchedule" asp-action="Create" class="action-card">
                <i class="bi bi-plus-circle"></i>
                <span>New Schedule</span>
            </a>
            <!-- Post Announcement -->
            <a asp-controller="AnnouncementandBulletinBoard" asp-action="Create" class="action-card">
                <i class="bi bi-megaphone"></i>
                <span>Post Announcement</span>
            </a>
            <!-- Add Bulletin -->
            <a asp-controller="AnnouncementandBulletinBoard" asp-action="BulletinBoardCreate" class="action-card">
                <i class="bi bi-images"></i>
                <span>Add Bulletin</span>
            </a>
        </div>
    </div>

</div>