@model TisaWasteManagement.Models.ReportFile

@{
    ViewData["Title"] = "Delete File";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/FileStyles.css" />
}

<div class="file-management-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="page-header">
        <div class="page-header-left">
            <h1 class="page-title text-danger">
                <i class="bi bi-exclamation-triangle"></i> Confirm Delete
            </h1>
            <p class="page-subtitle">This action cannot be undone</p>
        </div>
        <div class="page-header-right">
            <a asp-action="Index" class="btn btn-cancel">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <!-- ===== CONFIRMATION ===== -->
    <div class="module-card">
        <div class="module-card-body">
            <p class="text-danger fw-bold">Are you sure you want to delete this file? This action cannot be undone.</p>

            <div class="delete-preview">
                <dl class="detail-list">
                    <div class="detail-row">
                        <dt class="detail-label">File Name</dt>
                        <dd class="detail-value">@Model.FileName</dd>
                    </div>
                    <div class="detail-row">
                        <dt class="detail-label">Category</dt>
                        <dd class="detail-value">
                            <span class="category-badge @(Model.Category == "General" ? "badge-general" :
                                                                                          Model.Category == "Report" ? "badge-report" :
                                                                                          Model.Category == "Guideline" ? "badge-guideline" :
                                                                                          Model.Category == "Resolution" ? "badge-resolution" : "badge-general")">
                                @Model.Category
                            </span>
                        </dd>
                    </div>
                    <div class="detail-row">
                        <dt class="detail-label">File Type</dt>
                        <dd class="detail-value">@Model.FileType.ToUpper()</dd>
                    </div>
                    <div class="detail-row">
                        <dt class="detail-label">File Size</dt>
                        <dd class="detail-value">@(Model.FileSize > 1024 ? $"{Model.FileSize / 1024.0:F1} MB" : $"{Model.FileSize} KB")</dd>
                    </div>
                    <div class="detail-row">
                        <dt class="detail-label">Uploaded By</dt>
                        <dd class="detail-value">@Model.UploadedBy</dd>
                    </div>
                    <div class="detail-row">
                        <dt class="detail-label">Upload Date</dt>
                        <dd class="detail-value">@Model.UploadDate.ToString("MMMM dd, yyyy h:mm tt")</dd>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="detail-row">
                            <dt class="detail-label">Description</dt>
                            <dd class="detail-value">@Model.Description</dd>
                        </div>
                    }
                </dl>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReportFileId" />
                <div class="form-actions">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                    <a asp-action="Index" class="btn btn-cancel">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>