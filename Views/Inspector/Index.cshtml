@{
    ViewData["Title"] = "Inspector Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/InspectorStyles.css" />
}

<div class="dashboard-page">

    <!-- Page Header -->
    <div class="dashboard-header">
        <div>
            <h1 class="dashboard-title">Inspector Dashboard</h1>
            <p class="dashboard-subtitle">Monitor and track waste collection activities</p>
        </div>
        <div class="dashboard-date">
            <i class="bi bi-calendar3"></i>
            <span>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card stat-card-blue">
            <div class="stat-icon"><i class="bi bi-calendar-day"></i></div>
            <div class="stat-info">
                <span class="stat-number">@(ViewBag.TodaysCollections ?? 0)</span>
                <span class="stat-label">Today's Collections</span>
            </div>
        </div>
        <div class="stat-card stat-card-orange">
            <div class="stat-icon"><i class="bi bi-clock"></i></div>
            <div class="stat-info">
                <span class="stat-number">@(ViewBag.PendingCollections ?? 0)</span>
                <span class="stat-label">Pending Collections</span>
            </div>
        </div>
        <div class="stat-card stat-card-green">
            <div class="stat-icon"><i class="bi bi-check-circle"></i></div>
            <div class="stat-info">
                <span class="stat-number">@(ViewBag.CompletedCollections ?? 0)</span>
                <span class="stat-label">Completed Collections</span>
            </div>
        </div>
        <div class="stat-card stat-card-red">
            <div class="stat-icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div class="stat-info">
                <span class="stat-number">@(ViewBag.DelayedCollections ?? 0)</span>
                <span class="stat-label">Delayed Collections</span>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
        <div class="quick-actions-header">
            <h3><i class="bi bi-lightning"></i> Quick Actions</h3>
        </div>
        <div class="actions-grid">
            <a asp-controller="CollectionMonitoring" asp-action="Index" class="action-card">
                <i class="bi bi-clipboard-check"></i>
                <span>View Monitoring</span>
            </a>
            <a asp-controller="ComplaintManagement" asp-action="Index" class="action-card">
                <i class="bi bi-check2-circle"></i>
                <span>Resolve Complaints</span>
            </a>
        </div>
    </div>

</div>