@model TisaWasteManagement.Models.AccountChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AccountManagementStyles.css" />
}

<div class="module-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Change Password</h1>
            <p class="page-subtitle">
                Set a new password for the @Model.Type.ToString().ToLower() account
                <strong>@Model.Username</strong>
            </p>
        </div>
    </div>

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert-danger-custom">
            <i class="bi bi-exclamation-circle"></i>
            @TempData["Error"]
        </div>
    }

    <!-- Form -->
    <div class="module-card">
        <div class="module-card-header">
            <h4><i class="bi bi-key"></i> Change Password</h4>
        </div>
        <div class="module-card-body">
            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <!-- Both hidden fields are needed so the controller knows
                     WHICH account to update - see the same note in
                     Edit.cshtml. -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Type" />

                <div asp-validation-summary="ModelOnly" class="alert-danger-custom" style="margin-bottom: 16px;"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="NewPassword" class="form-label">
                            New Password <span class="required">*</span>
                        </label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter new password..." />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                        <span class="form-text">Minimum 6 characters.</span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label">
                            Confirm Password <span class="required">*</span>
                        </label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm new password..." />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-primary">
                        <i class="bi bi-check-lg"></i> Update Password
                    </button>
                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
