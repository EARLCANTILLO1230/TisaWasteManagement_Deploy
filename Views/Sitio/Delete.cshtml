@model TisaWasteManagement.Models.Sitio

@{
    ViewData["Title"] = "Delete Sitio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/SitioStyles.css" />
}

<div class="module-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Delete Sitio</h1>
            <p class="page-subtitle">Confirm deletion of this sitio</p>
        </div>
    </div>

    <!-- Warning Message -->
    <div class="alert-danger-custom">
        <i class="bi bi-exclamation-triangle"></i>
        Are you sure you want to delete this sitio? This action cannot be undone.
    </div>

    <!-- Details -->
    <div class="module-card">
        <div class="module-card-header">
            <h4><i class="bi bi-geo-alt"></i> Sitio Information</h4>
        </div>
        <div class="module-card-body">
            <dl class="detail-list">
                <div class="detail-row">
                    <dt class="detail-label">Sitio Name</dt>
                    <dd class="detail-value">@Html.DisplayFor(model => model.SitioName)</dd>
                </div>
            </dl>

            <form asp-action="Delete" method="post" style="margin-top: 20px;">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="SitioId" />

                <div class="form-actions">
                    <button type="submit" class="btn-danger">
                        <i class="bi bi-trash"></i> Yes, Delete
                    </button>
                    <a asp-action="Index" class="btn-cancel">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>