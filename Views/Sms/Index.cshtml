@model List<TisaWasteManagement.Models.SmsLog>
@{
    // SMS Module
    // -----------
    // This page shows a table of every SMS the system has tried to send,
    // plus quick counters for how many succeeded ("Sent") vs failed.
    ViewData["Title"] = "SMS Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">SMS Logs</h1>
        <p class="text-muted">View SMS notifications sent to residents.</p>
    </div>
    <span class="badge bg-success">@ViewBag.Provider</span>
</div>

<!-- Simple counters -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h6>Total Sent</h6>
                <h3>@ViewBag.TotalSent</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-danger text-white">
            <div class="card-body">
                <h6>Total Failed</h6>
                <h3>@ViewBag.TotalFailed</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h6>Provider</h6>
                <h3>@ViewBag.Provider</h3>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <!-- Empty state: shown when no SMS has been sent yet -->
    <div class="text-center text-muted py-5">
        <i class="bi bi-envelope" style="font-size: 3rem;"></i>
        <p class="mt-3">No SMS logs found.</p>
        <p class="text-muted small">SMS will appear here when complaint statuses are updated.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Number</th>
                    <th>Message</th>
                    <th>Type</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.SentDate.ToString("MMM d, yyyy h:mm tt")</td>
                        <td>@item.RecipientNumber</td>
                        <td>@item.Message</td>
                        <td><span class="badge bg-info">@item.NotificationType</span></td>
                        <td>
                            <span class="badge @(item.Status == "Sent" ? "bg-success" : "bg-danger")">
                                @item.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
