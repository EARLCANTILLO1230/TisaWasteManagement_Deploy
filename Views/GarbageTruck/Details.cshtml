@model TisaWasteManagement.Models.GarbageTruck

@{
    ViewData["Title"] = "Truck Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/GarbageTruckStyles.css" />
}

<div class="module-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Truck Details</h1>
            <p class="page-subtitle">View truck information</p>
        </div>
        <div class="page-actions">
            <a asp-action="Edit" asp-route-id="@Model?.TruckId" class="btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
        </div>
    </div>

    <!-- Details -->
    <div class="module-card">
        <div class="module-card-header">
            <h4><i class="bi bi-truck"></i> Truck Information</h4>
        </div>
        <div class="module-card-body">
            <dl class="detail-list">
                <div class="detail-row">
                    <dt class="detail-label">Plate Number</dt>
                    <dd class="detail-value">@Html.DisplayFor(model => model.PlateNumber)</dd>
                </div>
                <div class="detail-row">
                    <dt class="detail-label">MV File Number</dt>
                    <dd class="detail-value">@Html.DisplayFor(model => model.MVFileNumber)</dd>
                </div>
                <div class="detail-row">
                    <dt class="detail-label">Status</dt>
                    <dd class="detail-value">
                        @if (Model.StatusFlag == "Active")
                        {
                            <span class="badge-status badge-active">Active</span>
                        }
                        else if (Model.StatusFlag == "Maintenance")
                        {
                            <span class="badge-status badge-maintenance">Maintenance</span>
                        }
                        else if (Model.StatusFlag == "Inactive")
                        {
                            <span class="badge-status badge-inactive">Inactive</span>
                        }
                        else
                        {
                            <span class="badge-status">@Html.DisplayFor(model => model.StatusFlag)</span>
                        }
                    </dd>
                </div>
            </dl>

            <div class="form-actions">
                <a asp-action="Index" class="btn-cancel">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>

</div>