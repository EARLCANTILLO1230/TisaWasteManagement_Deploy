@model List<TisaWasteManagement.Models.Announcement>
@using TisaWasteManagement.Models

@{
    ViewData["Title"] = "Manage Announcements & Bulletin Board";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var bulletinBoardImages = ViewBag.BulletinBoardImages as List<BulletinBoardImage> ?? new List<BulletinBoardImage>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/AnnouncementandBulletinBoardStyles.css" />
}

<div class="module-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-megaphone"></i> Announcements &amp; Bulletin Board
            </h1>
            <p class="page-subtitle">Manage announcements and bulletin board images for residents</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-primary" asp-action="Create">
                <i class="bi bi-plus-lg"></i> New Announcement
            </a>
            <a class="btn btn-primary" asp-action="BulletinBoardCreate">
                <i class="bi bi-plus-lg"></i> New Bulletin Board
            </a>
        </div>
    </div>

    <!-- ===== ALERT MESSAGES ===== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success-custom alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger-custom alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ===== ANNOUNCEMENTS SECTION ===== -->
    <section class="announcement-section">
        <div class="section-header">
            <h3><i class="bi bi-megaphone"></i> Announcements</h3>
            <span class="section-count">@Model.Count() announcement(s)</span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-megaphone empty-icon"></i>
                <h4 class="empty-title">No announcements yet</h4>
                <p class="empty-description">Click "New Announcement" to create one.</p>
            </div>
        }
        else
        {
            <div class="announcement-grid">
                @foreach (var item in Model)
                {
                    <div class="announcement-card">
                        @if (!string.IsNullOrEmpty(item.ImageFileName))
                        {
                            <div class="announcement-image">
                                <img src="~/images/announcements/@item.ImageFileName" alt="@item.Title" />
                            </div>
                        }
                        <div class="announcement-body">
                            <h5 class="announcement-title">@item.Title</h5>
                            <p class="announcement-content">@item.Content</p>
                            <p class="announcement-date">
                                <i class="bi bi-calendar3"></i> Posted @item.DatePosted.ToString("MMM dd, yyyy")
                            </p>
                            <div class="announcement-actions">
                                <a class="btn-action btn-edit" asp-action="Edit" asp-route-id="@item.AnnouncementId">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a class="btn-action btn-delete" asp-action="Delete" asp-route-id="@item.AnnouncementId">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- ===== BULLETIN BOARD SECTION ===== -->
    <section class="bulletin-section">
        <div class="section-header">
            <h3><i class="bi bi-images"></i> Bulletin Board</h3>
            <span class="section-count">@bulletinBoardImages.Count() image(s)</span>
        </div>

        @if (!bulletinBoardImages.Any())
        {
            <div class="empty-state">
                <i class="bi bi-images empty-icon"></i>
                <h4 class="empty-title">No pictures posted yet</h4>
                <p class="empty-description">Click "New Bulletin Board" to add one.</p>
            </div>
        }
        else
        {
            <div class="bulletin-grid">
                @foreach (var pic in bulletinBoardImages)
                {
                    <div class="bulletin-card">
                        <div class="bulletin-image">
                            <img src="~/images/bulletinboard/@pic.ImageFileName" alt="@pic.Caption" />
                            @if (!string.IsNullOrEmpty(pic.Caption))
                            {
                                <div class="bulletin-overlay">
                                    <span>@pic.Caption</span>
                                </div>
                            }
                        </div>
                        <div class="bulletin-footer">
                            @if (!string.IsNullOrEmpty(pic.Caption))
                            {
                                <span class="bulletin-caption">@pic.Caption</span>
                            }
                            <a class="btn-action btn-delete" asp-action="BulletinBoardDelete" asp-route-id="@pic.BulletinBoardImageId">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}