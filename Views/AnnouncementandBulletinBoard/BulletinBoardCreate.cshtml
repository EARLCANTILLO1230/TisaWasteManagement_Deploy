@{
    ViewData["Title"] = "New Bulletin Board Picture";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AnnouncementandBulletinBoardStyles.css" />
}

<div class="module-page">

    <!-- ===== PAGE HEADER ===== -->
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-plus-circle"></i> New Bulletin Board Picture
            </h1>
            <p class="page-subtitle">Upload a new image for the bulletin board</p>
        </div>
        <div class="page-actions">
            <a asp-action="Index" class="btn btn-cancel">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <!-- ===== FORM ===== -->
    <div class="module-card">
        <div class="module-card-body">
            <form asp-action="BulletinBoardCreate" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger-custom"></div>

                <div class="form-group">
                    <label class="form-label">
                        Picture <span class="required">*</span>
                    </label>
                    <input type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.gif" required />
                    <div class="form-text">Accepted formats: JPG, PNG, GIF. Max size 5 MB.</div>
                </div>

                <div class="form-group">
                    <label class="form-label">Caption <span class="text-muted">(Optional)</span></label>
                    <input type="text" name="caption" class="form-control" maxlength="150"
                           value="@ViewBag.Caption" placeholder="e.g. Proper Waste Segregation" />
                    <div class="form-text">Maximum 150 characters.</div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-upload"></i> Upload Picture
                    </button>
                    <a asp-action="Index" class="btn btn-cancel">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>

</div>